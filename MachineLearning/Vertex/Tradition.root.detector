% 功能：配置 myTOGAXSI_ppalpha 的靶、虚拟面、SSD 与 GAGG 几何。
% 方法：按已有各探测器位置建立几何；RecoilGAGG 用七位 Optical 开关选择双端光学晶体。
% 注意事项：原有 z 坐标已减去 82 mm；Optical 默认全关，开启时需 OpticalPhysics=1。
%所有的z坐标都减去了82mm
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
Target
 THICKNESS= 150 mm
 RADIUS= 15.5 mm
 MATERIAL= LH2
 ANGLE= 0 deg
 NbSlices= 200
 X= 0 mm
 Y= 0 mm
 Z= 0 mm


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
VirtualPlane
 Type = VirtualBDC
 Z = -150 mm
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%VirtualPlane
 Type = VirtualFDC2Front
 POS = -6500 0 6500 mm
 ANGLE = 30 deg
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%VirtualPlane
 Type = VirtualFDC2Back
 POS = -6750 0 6933.0127019 mm
 ANGLE = 30 deg
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%HODOScope
 Type= HODP
 POS= -3500 0 9250 mm
 ANGLE= 30 deg
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%HODOScope
 Type= HODF
 POS= -6200 0 7750 mm
 ANGLE= 30 deg
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%Samurai
 POS= 0 0 3900 mm
 ANGLE= 30 deg
% %
 METHOD= 0				
% % 0=RungeKutta, 1=EliaOmar
 FIELDMAP= field_map/180628-2,20T-3000.table.bin
 %FIELDMAP= field_map/141113-0,5T-3000.table.bin
 %FIELDMAP= field_map/180626-1,00T-3000.table.bin
% % fieldmap path
 STEPS_PER_METER= 1000

