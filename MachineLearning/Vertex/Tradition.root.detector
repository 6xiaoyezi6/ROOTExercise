%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%% RecoilGAGG %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% 功能：以下 RecoilGAGG 每组七根晶体可逐根开启双端光学读出。
% 方法：Optical 的七个 0/1 依次对应晶体 1..7；开启前将本项目 PhysicsListOption.txt 的 OpticalPhysics 设为 1。
% 注意事项：默认全关，带电粒子在晶体内的路程仍写入 LengthInGAGG，单位 mm。
RecoilGAGG
 Type = RecoilGAGGLD
 POS = 138.56 -80 116 mm
 ROT = -60 0 0 deg
 Optical = 0 0 0 0 0 0 0

RecoilGAGG
 Type = RecoilGAGGLU
 POS = 138.56 80 116 mm
 ROT = -120 0 0 deg
 Optical = 0 0 0 0 0 0 0

RecoilGAGG
 Type = RecoilGAGGRU
 POS = -138.56 80 116 mm
 ROT = 120 0 0 deg
 Optical = 0 0 0 0 0 0 0

RecoilGAGG
 Type = RecoilGAGGRD
 POS = -138.56 -80 116 mm
 ROT = 60 0 0 deg
 Optical = 0 0 0 0 0 0 0

%RecoilGAGG
 Type = RecoilGAGGDOWN
 POS = 0 -160 116 mm
 ROT = 0 0 0 deg

%RecoilGAGG
 Type = RecoilGAGGUP
 POS = 0 160 116 mm
 ROT = 180 0 0 deg

